// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

model User {
  user_id           String   @id @default(uuid(7)) @db.Uuid
  first_name        String
  last_name         String
  email             String   @unique
  password          String?

  image             String?
  birth_date        DateTime?
  birth_place       String?
  phone_number      String?
  country           String?
  city              String?
  address           String?

  q1                String?
  q2                String?

  remember_token      String?  @db.Text
  current_token       String?  @db.Text
  default_space_id    String?  @db.Uuid

  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt

  plan              Plan     @default(FREE)

  space_owned       Space[]  
  spaces            SpaceMember[]

  @@map("users")
  @@index([email], name: "idx_users_email")
  @@index([user_id], name: "idx_users_id")
}

model Space {
  space_id                String   @id @default(uuid(7)) @db.Uuid
  name              String
  description       String?
  is_personal       Boolean  @default(false)
  owner_id          String   @db.Uuid

  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt

  owner             User     @relation(fields: [owner_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  space_members     SpaceMember[]
  accounts          Account[]
  categories        Category[]

  @@map("spaces")
}

model SpaceMember {
  space_member_id   String   @id @default(uuid(7)) @db.Uuid
  space_id          String   @db.Uuid
  user_id           String   @db.Uuid
  is_default        Boolean  @default(false)

  created_at        DateTime @default(now())
  updated_at        DateTime? @updatedAt

  space             Space    @relation(fields: [space_id], references: [space_id], onDelete: Cascade, onUpdate: Cascade)
  user              User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)

  @@map("space_members")
}

enum Account_type {
  CASH
  BANK
  CREDIT_CARD
  DEBIT_CARD
  E_WALLET
  INVESTMENT
  LOAN
}

model Account{
  account_id          String @id @default(uuid(7)) @db.Uuid
  space_id            String @db.Uuid
  name                String
  description         String?
  currency            String? @default("IDR")
  balance             Float? @default(0)
  type                Account_type @default(CASH)

  icon                String?
  color               String?
  bg_color            String?

  space               Space    @relation(fields: [space_id], references: [space_id], onDelete: Cascade, onUpdate: Cascade)
  @@map("accounts")
}

model Account_example {
  account_example_id  String @id @default(uuid(7)) @db.Uuid
  name                String @unique
  description         String?
  currency            String @default("IDR")
  type                String @default("bank")

  icon                String
  color               String
  bg_color            String
}

enum Transaction_model {
  TRANSACTION
  TRANSFER
}

enum Transaction_type {
  INCOME
  EXPENSE
}

model Category {
  category_id         String @id @default(uuid(7)) @db.Uuid
  space_id            String @db.Uuid
  name                String
  description         String?
  type                Transaction_type
  icon                String? 

  subcategories       Subcategory[]
  space               Space    @relation(fields: [space_id], references: [space_id], onDelete: Cascade, onUpdate: Cascade)

  @@map("categories")
}

model Subcategory {
  subcategory_id      String @id @default(uuid(7)) @db.Uuid
  category_id         String @db.Uuid
  name                String
  description         String?      
  icon                String?

  category            Category  @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: Cascade)
  transactions        Transaction[]

  @@map("subcategories")
}
model Transaction{
  transaction_id      String @id @default(uuid(7)) @db.Uuid
  account_id          String @db.Uuid
  title               String
  note                String?
  subcategory_id      String? @db.Uuid
  amount              Float   @default(0)
  currency            String? @default("IDR")
  date                DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime? @updatedAt

  model               Transaction_model @default(TRANSACTION)
  type                Transaction_type
  subcategory         Subcategory? @relation(fields: [subcategory_id], references: [subcategory_id], onDelete: Cascade, onUpdate: Cascade)

  @@map("transactions")
}