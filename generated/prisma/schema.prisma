// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  first_name   String
  last_name    String
  email        String    @unique
  password     String?
  birth_date   DateTime?
  birth_place  String?
  phone_number String?
  country      String?
  city         String?
  address      String?

  q1 String?
  q2 String?

  remember_token   String? @db.Text
  current_token    String? @db.Text
  default_space_id String? @db.Uuid

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  space_owned Space[]
  spaces      SpaceMember[]

  @@index([email], name: "idx_users_email")
  @@index([id], name: "idx_users_id")
  @@map("users")
}

model Space {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  is_personal Boolean @default(false)
  owner_id    String  @db.Uuid

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  owner         User          @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  space_members SpaceMember[]

  @@map("spaces")
}

model SpaceMember {
  id         String  @id @default(uuid(7)) @db.Uuid
  space_id   String  @db.Uuid
  user_id    String  @db.Uuid
  is_default Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  space Space @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("space_members")
}
